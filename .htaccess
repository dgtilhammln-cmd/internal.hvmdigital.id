RewriteEngine On
RewriteBase /

# 1. PAKSA index.php sebagai file default dalam folder
DirectoryIndex index.php

# 2. Mencegah list folder (Security)
Options -Indexes

# 3. Tambahkan Trailing Slash jika membuka folder
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(/$|index\.php)
RewriteRule ^(.*)$ %{REQUEST_URI}/ [R=301,L]

# 4. Jangan ubah file/folder yang beneran ada
RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. Hilangkan ekstensi .php (Clean URL) 
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 6. Error Handling
ErrorDocument 404 /404.php